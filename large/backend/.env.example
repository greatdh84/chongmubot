# 복사해서 backend/.env 로 사용하세요. 이 파일에는 변수 이름만 둡니다(값을 적지 마세요).
# Slack 봇 토큰(SLACK_BOT_TOKEN)·Claude 키(LLM_API_KEY)는 소모임과 같이 저장소 루트 .env 에서 읽습니다.
APP_MODE=
# 알림: mock(기본, 개발용 수신함) | slack(루트 .env 의 SLACK_BOT_TOKEN 으로 실제 DM)
NOTIFY_MODE=
# LLM: mock(기본, 규칙 기반) | claude(루트 .env 의 LLM_API_KEY) | gemini
LLM_MODE=
CLAUDE_MODEL=
DATABASE_URL=
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUBLIC_BASE_URL=
EMAIL_DAILY_LIMIT=
EMAIL_QUIET_START=
EMAIL_QUIET_END=
NOTIFY_SCHEDULER=
EMAIL_SCHEDULER_INTERVAL=
GEMINI_API_KEY=
GEMINI_MODEL=
# 슬랙 실시간 연동(Events API → POST /api/large/slack/events). 기본 off. 켜면 서명 비밀값이 필요(없으면 모든 요청 403)
SLACK_EVENTS=
# Slack 앱 'Basic Information → Signing Secret'. 루트 .env 에 두어도 읽음(값은 커밋 금지)
SLACK_SIGNING_SECRET=
